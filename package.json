{
  "name": "@prjct.app/team-core",
  "version": "0.2.0",
  "description": "Local-first team transport shared by pi-team and the Claude Code team mod: durable inboxes, presence, activity and timeline on disk, plus the team-bridge process.",
  "type": "module",
  "keywords": [
    "multi-agent",
    "agent-collaboration",
    "messaging",
    "local-first"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "team-bridge": "dist/bin/team-bridge.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin/team-bridge.js",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "! grep -rn '\\blet\\b' src/ || (echo 'Use immutable values: no let bindings in src/' && exit 1)",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build",
    "check:package": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/team-core.git"
  },
  "homepage": "https://github.com/prjct-app/team-core#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/team-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
